<!-- StrideMcpPlugin.Editor.csproj -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referencias a las librerías del editor de Stride -->
    <PackageReference Include="Stride.Core" Version="4.4.*" PrivateAssets="All" />
    <PackageReference Include="Stride.Core.Assets.Editor" Version="4.4.*" PrivateAssets="All" />
    <PackageReference Include="Stride.Assets.Presentation" Version="4.4.*" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="StrideMcpServer\**\*.cs" />
    <Compile Remove="StrideMcpBootstrap\**\*.cs" />
  </ItemGroup>
</Project>
